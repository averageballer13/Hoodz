# =============================================================================
# Hoodz - environment template.  Copy to .env and fill in.  NEVER commit .env
# =============================================================================

# --- Deployer ----------------------------------------------------------------
# Hex private key, with or without the 0x prefix. Use a burner for testnet.
# Prefer `cast wallet` / a hardware wallet for anything touching mainnet.
PRIVATE_KEY=
DEPLOYER_ADDRESS=

# --- Robinhood Chain ---------------------------------------------------------
# Mainnet: chainId 4663 | Testnet: chainId 46630 | gas token: ETH
ROBINHOOD_CHAIN_ID=4663
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com

ROBINHOOD_TESTNET_CHAIN_ID=46630
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_TESTNET_EXPLORER_URL=https://testnet.robinhoodchain.blockscout.com

# --- Verification (Blockscout is Etherscan-API compatible) -------------------
# Blockscout usually accepts any non-empty string.
BLOCKSCOUT_API_KEY=blockscout

# --- HoodzAuthority roles (deployment inputs) ---------------------------------
# Multisig / timelock addresses. Leave blank to default to the deployer.
HOODZ_GOVERNOR=
HOODZ_GUARDIAN=
HOODZ_POLICY=
HOODZ_VAULT=

# --- PONS launch parameters --------------------------------------------------
# The PONS launchpad on Robinhood Chain. HOODZ starts on a bonding curve and only
# graduates into a permanently locked Uniswap v4 pool.
PONS_LAUNCHPAD=
PONS_BONDING_CURVE=
PONS_FEE_ROUTER=
PONS_RESERVE_TOKEN=
PONS_TARGET_RAISE=
PONS_GRADUATION_THRESHOLD=
PONS_LP_FEE_TIER=
PONS_LOCK_BENEFICIARY=

# --- Protocol config ---------------------------------------------------------
# Epoch length in seconds (Olympus used 8 hours = 28800).
HOODZ_EPOCH_LENGTH=28800
HOODZ_FIRST_EPOCH_NUMBER=1
HOODZ_FIRST_EPOCH_TIME=

# ---------------------------------------------------------------------------
# HOODZ token (PONS-deployed)
# ---------------------------------------------------------------------------
# This repo does NOT deploy HOODZ. Launch it on PONS first - the launchpad
# deploys the ERC20 from its own factory with a fixed 1,000,000,000 supply,
# the whole amount sold on the bonding curve, no mint function and no owner.
# Then paste the resulting token address here and deploy the protocol against it.
HOODZ_TOKEN=
